{
  "name": "@lenticule-science/typed-circuit-residue-assay",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Independent typed closed-circuit residue assay over sovereign hierarchical FOUR circuit seams.",
  "exports": {
    ".": "./src/assay.mjs",
    "./client": "./src/client.mjs",
    "./test-provider": "./src/test-provider.mjs"
  },
  "bin": {
    "serve-typed-circuit-residue-assay-a2a": "./scripts/server.mjs"
  },
  "scripts": {
    "check": "node --check src/semantic-json.mjs && node --check src/assay.mjs && node --check src/client.mjs && node --check src/test-provider.mjs && node --check scripts/execute-a2a-task.mjs && node --check scripts/server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.9",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.2",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.4",
    "@red-cup-engineering/relation-model-notation-cbor-codec": "0.1.1",
    "@red-cup-engineering/relation-model-notation-runtime": "0.12.1",
    "@red-cup-engineering/relational-value-graph-service": "0.1.4",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.5",
    "@red-cup-engineering/witness-journal-entry-service": "0.1.5",
    "@red-cup-engineering/witness-journal-log-service": "0.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenticule-science/typed-circuit-residue-assay.git"
  }
}
