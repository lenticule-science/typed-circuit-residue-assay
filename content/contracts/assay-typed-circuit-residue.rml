#lang rmn/v2
(map
  ("type" "TypedCircuitResidueAssayLaw")
  ("version" 1)
  ("precondition" "A customer supplies one exact placement-neutral hierarchical FOUR circuit family, one exact sovereign occurrence assembly, one declared border class, and one bounded closed trace whose steps carry typed par-seam receipts.")
  ("operation" "Verify the circuit family and complete assembly; resolve receipt authority from addressed sovereign occurrences; require every route edge to be one declared par net on its declared CAIP-2 chain and RMN contract; reject open routes and replayed receipts; require every signed seam translation to be pre-transported into one declared ambient frame; assay Chu seam defect, C4 rotational holonomy, signed Z^2 translational Burgers residue, their affine composition, typed price and erasure residue, and exact economic current-affinity residue as separate typed results; and bind the exact request, provider account, result, and replay material.")
  ("postcondition" "Return one canonical signed-provider RMN receipt binding request, circuit, assembly, component definitions, border-relative disposition, distinct rotational, translational, and affine residue carriers, receipt count, and fuel used without reading a component interior or making an automatic legal or fraud judgment.")
  ("refusal" "Refuse malformed circuit, assembly, trace, receipt, chain, contract, authority, border, unit, rational, FOUR, C4, coordinate-frame, or signed-translation values; missing occurrence population; tensor traces; open routes; replay; fuel excess; frame transport mismatch; undeclared affine holonomy; self-substitution; or any collapse of typed residue dimensions."))
